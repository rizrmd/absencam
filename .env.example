# Copy to .env in the repo root (or export in your shell).

APP_NAME=absencam-api
APP_VERSION=0.1.0
APP_ENV=development
API_ADDR=:8080
DATABASE_URL=postgres://absencam:absencam@127.0.0.1:5432/absencam?sslmode=disable
CORS_ORIGINS=*
FACE_MATCH_THRESHOLD=0.40

# Frontend (optional; Vite proxies /api to the Go server)
VITE_API_BASE_URL=
